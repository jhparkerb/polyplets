# copyrighted papers stay local, never pushed
papers/
__pycache__/
*.pyc
build/
runs/
harness/harness

# macOS filesystem cruft (esp. ._* AppleDouble files from Mac->Linux copies)
.DS_Store
._*

# generated bench_column fixtures/results (regenerable)
experiments/*.bin
experiments/*.bin.hash
experiments/bench_column_results.txt

# clangd compile DB — host-specific absolute paths; regenerate via `make compile-commands`
# The .tmp sibling is the write-then-rename staging file; it only survives a crash.
compile_commands.json
compile_commands.json.tmp
.cache/
experiments/frontier_svd/frontier_*.txt

# probe/validation run dumps (regenerable)
experiments/**/*.out
*.local

# local-only study notes — never commit (guard also in .git/info/exclude)
docs/viva-*.md
docs/drill*.md

# Scratch staging for results files a run is still writing (see
# scripts/severance_e4_k21.sh): an untracked file under results/ stamps every
# binary built while it is there as -dirty.
results/*.partial
