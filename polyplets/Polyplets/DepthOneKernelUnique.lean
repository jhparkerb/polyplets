set_option maxRecDepth 8000 in
-- the emitted linear_combination is a single huge sum;
-- elaborating it needs recursion headroom beyond the default
theorem walkRow5Bare {F : St → Nat} (h : StartData F 1 0 1 1) :
    m51Bare * (jS F 1) + m52Bare * (jS F 2) + m53Bare * (jS F 3) + m54Bare * (JmS F) + m55Bare * (pS F 2) + m56Bare * (pS F 3) = r5Bare := by
  have hP := closing_P_u1 h
  unfold Qpser RPser P0ser c1S c2S c3S c4S Kernel.dP at hP
  simp only [map_natCast] at hP
  push_cast at hP
  have hfac : (512 : PowerSeries ℚ) * X ^ 7 ≠ 0 := by
    have hn : (512 : PowerSeries ℚ) ≠ 0 := by
      intro hh
      have hz := congrArg constantCoeff hh
      rw [show constantCoeff (512 : PowerSeries ℚ) = 512 from map_ofNat constantCoeff 512, map_zero] at hz
      norm_num at hz
    exact mul_ne_zero hn (pow_ne_zero 7 X_ne_zero)
