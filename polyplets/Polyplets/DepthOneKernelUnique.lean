theorem walkRow6Int {F : St → Nat} (h : StartData F 4 1 4 6) :
    m61Int * (jS F 1) + m62Int * (jS F 2) + m63Int * (jS F 3) + m64Int * (JmS F) + m65Int * (pS F 2) + m66Int * (pS F 3) = r6Int := by
