/-- The determinant of the cleared system, in closed basis form. -/
theorem det_matInt : (matInt).det = detTupInt := by
  sorry

/-- The determinant certificate: the order-22 coefficient is `−64`. -/
-- sanity (python): coeff 22 detTupInt = -64
