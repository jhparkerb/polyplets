/-- **k=1 grand form** (from the existing closed form `P1_pinned`):
`3^(3·1+1)·T(H+1,H) = P_1(H+1)·3^(H+1)` for all `H ≥ 1+1`. -/
theorem P1_grand : ∀ H : ℕ, 1 + 1 ≤ H →
    (3 : ℚ) ^ (3 * 1 + 1) * (T (H + 1) H : ℚ) = Pp1.eval ((H : ℚ) + 1) * 3 ^ (H + 1) := by
  intro H hH
  have hn := P1_pinned (H + 1) (by omega)
  rw [show H + 1 - 1 = H from by omega] at hn
  push_cast at hn
  rw [hn, ← mul_assoc, mul_comm ((3 : ℚ) ^ (3 * 1 + 1)) _, mul_assoc]
  congr 1
  rw [← zpow_natCast (3 : ℚ) (3 * 1 + 1), ← zpow_natCast (3 : ℚ) (H + 1),
    ← zpow_add₀ (by norm_num : (3 : ℚ) ≠ 0)]
  congr 1
  push_cast; ring

