/-- **μ_4 solved from the staircase** at `H=4+1`: the second real cell
`B_4 = T(10,6)` pins `μ_4`. -/
lemma mu4_val
    (hA4 : T 9 5 = 278240)
    (hB4 : T 10 6 = 1631340) :
