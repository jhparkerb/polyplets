/-! ### Step (A.1): the cleared quartic descends to `phiF1` -/

private theorem phiDen_ne : phiDen ≠ 0 := by
  intro h
  have hne : constantCoeff phiDen ≠ 0 := by rw [phiDen_const]; norm_num
  exact hne (by rw [h, map_zero])

private theorem phiDen_mul_phiF1 : phiDen * phiF1 = numTuple := by
  have hne : constantCoeff phiDen ≠ 0 := by rw [phiDen_const]; norm_num
  have hinv : phiDen * phiDen⁻¹ = 1 := PowerSeries.mul_inv_cancel _ hne
  unfold phiF1
  rw [show phiDen * (numTuple * phiDen⁻¹) = numTuple * (phiDen * phiDen⁻¹) from by ring, hinv,
    mul_one]

/-- The cleared quartic descends through the unit `phiDen`: `Σ_k cY_k(X²)·phiF1^k = 0`. -/
private theorem quartic_on_phiF1 :
    phiCY0sq + phiCY1sq * phiF1 + phiCY2sq * phiF1 ^ 2 + phiCY3sq * phiF1 ^ 3
        + phiCY4sq * phiF1 ^ 4 = 0 := by
  have hphiDen4_ne : phiDen ^ 4 ≠ 0 := pow_ne_zero 4 phiDen_ne
  have e1 : phiDen ^ 4 * phiF1 = phiDen ^ 3 * numTuple := by rw [← phiDen_mul_phiF1]; ring
  have e2 : phiDen ^ 4 * phiF1 ^ 2 = phiDen ^ 2 * numTuple ^ 2 := by
    rw [← phiDen_mul_phiF1]; ring
  have e3 : phiDen ^ 4 * phiF1 ^ 3 = phiDen ^ 1 * numTuple ^ 3 := by
    rw [← phiDen_mul_phiF1]; ring
  have e4 : phiDen ^ 4 * phiF1 ^ 4 = numTuple ^ 4 := by rw [← phiDen_mul_phiF1]; ring
  have hz : phiDen ^ 4 * (phiCY0sq + phiCY1sq * phiF1 + phiCY2sq * phiF1 ^ 2
      + phiCY3sq * phiF1 ^ 3 + phiCY4sq * phiF1 ^ 4) = 0 := by
    have heq : phiDen ^ 4 * (phiCY0sq + phiCY1sq * phiF1 + phiCY2sq * phiF1 ^ 2
        + phiCY3sq * phiF1 ^ 3 + phiCY4sq * phiF1 ^ 4)
        = phiCY0sq * phiDen ^ 4 + phiCY1sq * (phiDen ^ 4 * phiF1)
          + phiCY2sq * (phiDen ^ 4 * phiF1 ^ 2) + phiCY3sq * (phiDen ^ 4 * phiF1 ^ 3)
          + phiCY4sq * (phiDen ^ 4 * phiF1 ^ 4) := by ring
    rw [heq, e1, e2, e3, e4]
    have hbracket := quartic_cleared
    unfold bracket at hbracket
    rw [← hbracket]; ring
  rcases mul_eq_zero.mp hz with h | h
  · exact absurd h hphiDen4_ne
  · exact h

/-! ### Step (A.2): `phiCoeffSeries` of a literal list, as an explicit sum -/

private theorem phiCoeffSeries_eq_sum (c : List ℚ) :
    phiCoeffSeries c = ∑ i ∈ Finset.range c.length, PowerSeries.C (c.getD i 0) * X ^ i := by
  ext n
  rw [phiCoeffSeries, PowerSeries.coeff_mk, map_sum]
  simp only [PowerSeries.coeff_C_mul_X_pow]
  have hs : ∑ i ∈ Finset.range c.length, (if n = i then c.getD i 0 else (0 : ℚ))
      = if n = n then c.getD n 0 else 0 := by
    refine Finset.sum_eq_single n (fun b _ hb => if_neg (Ne.symm hb)) fun hn => ?_
    rw [Finset.mem_range, not_lt] at hn
    rw [if_pos rfl, List.getD_eq_default c 0 hn]
  rw [hs, if_pos rfl]

/-! ### Step (A.3): `phiF1` descends from `F1y` through `X ↦ X²` -/

private theorem phiF1_eq_expand2_F1y :
    phiF1 = PowerSeries.expand 2 (by norm_num : (2 : ℕ) ≠ 0) F1y := by
  ext n
  rcases Nat.even_or_odd n with ⟨m, hm⟩ | ⟨m, hm⟩
  · subst hm
    rw [show m + m = 2 * m from (two_mul m).symm, PowerSeries.coeff_expand_mul]
    unfold F1y
    rw [PowerSeries.coeff_mk]
  · subst hm
    rw [PowerSeries.coeff_expand_of_not_dvd (h := by omega)]
    exact phiF1_even m

private theorem expand2_eq_zero {z : PowerSeries ℚ}
    (h : PowerSeries.expand 2 (by norm_num : (2 : ℕ) ≠ 0) z = 0) : z = 0 := by
  ext n
  have h2 := congrArg (coeff (2 * n)) h
  rw [PowerSeries.coeff_expand_mul] at h2
  simpa using h2

private theorem expand2_phiCY0 :
    PowerSeries.expand 2 (by norm_num : (2 : ℕ) ≠ 0) (phiCoeffSeries phiCY0List) = phiCY0sq := by
  rw [phiCoeffSeries_eq_sum]
  show PowerSeries.expand 2 (by norm_num : (2:ℕ) ≠ 0)
