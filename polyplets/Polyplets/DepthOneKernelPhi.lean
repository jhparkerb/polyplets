/-- The lift identity, lifted to `ℚ⟦X⟧`: `3·Σ scale3(cY_k)·Y^k = Σ phiC_k·(1+3Y)^k`,
for any `Y`, by the same `ring` expansion as the scalar `lift_identity`. -/
private theorem lift_identity_series (Y : PowerSeries ℚ) :
    3 * (scale3 (phiCoeffSeries phiCY0List) + scale3 (phiCoeffSeries phiCY1List) * Y
          + scale3 (phiCoeffSeries phiCY2List) * Y ^ 2 + scale3 (phiCoeffSeries phiCY3List) * Y ^ 3
          + scale3 (phiCoeffSeries phiCY4List) * Y ^ 4)
      = phiCoeffSeries DepthOneSeries.phiCList0
          + phiCoeffSeries DepthOneSeries.phiCList1 * (1 + 3 * Y)
          + phiCoeffSeries DepthOneSeries.phiCList2 * (1 + 3 * Y) ^ 2
          + phiCoeffSeries DepthOneSeries.phiCList3 * (1 + 3 * Y) ^ 3
          + phiCoeffSeries DepthOneSeries.phiCList4 * (1 + 3 * Y) ^ 4 := by
  rw [scale3_phiCY0, scale3_phiCY1, scale3_phiCY2, scale3_phiCY3, scale3_phiCY4,
    phiCList0_expand, phiCList1_expand, phiCList2_expand, phiCList3_expand, phiCList4_expand]
  ring

/-- **The exact defect identity: `Φ(x, N(x)) = 0` in `ℚ⟦x⟧`.** -/
theorem phi_annihilates_exact : PhiOp Nexact = 0 := by
  have hN : Nexact = 1 + 3 * scale3 F1y := by linear_combination Nexact_sub_one
  have hQS : scale3 (phiCoeffSeries phiCY0List) + scale3 (phiCoeffSeries phiCY1List) * scale3 F1y
      + scale3 (phiCoeffSeries phiCY2List) * scale3 F1y ^ 2
      + scale3 (phiCoeffSeries phiCY3List) * scale3 F1y ^ 3
      + scale3 (phiCoeffSeries phiCY4List) * scale3 F1y ^ 4 = 0 := by
    have h := congrArg scale3 quartic_on_F1y
    rw [map_add, map_add, map_add, map_add, map_mul, map_mul, map_mul, map_mul, map_pow, map_pow,
      map_pow, map_zero] at h
    exact h
  unfold PhiOp
  rw [hN, ← lift_identity_series (scale3 F1y), hQS, mul_zero]

/-! ### Step (C): the walk-enumeration corollary.

`phi_annihilates_of_exact` re-derives `DepthOneSeries.phi_annihilates`
*given* the walk↔closed-form bridge `truncL 61 Nexact = nSeries 60` as an
explicit hypothesis. That bridge — the kernel closed form equals the walk's
own `walkFamilies` enumeration at all orders — is identity (II), scoped as
notary piece D; the existing `GapWalkBridge.f1_matches_depth1` /
`walk_table_19` links are `native_decide` at finite order only, and no
all-orders symbolic version exists in the development. It is deliberately
NOT proved here: piece K's deliverable is the unconditional
`phi_annihilates_exact` above, and this corollary shows exactly what the
finite `phi_annihilates` check would follow from. -/

/-- `tmul` only reads its left list through `getD` below `n`: agreement
there is enough to swap the list. -/
private theorem tmul_congr_left {a a' b : List ℚ} {n : ℕ}
    (h : ∀ i < n, a.getD i 0 = a'.getD i 0) :
    GapWalkBridge.tmul a b n = GapWalkBridge.tmul a' b n := by
  unfold GapWalkBridge.tmul
  refine List.map_congr_left fun k hk => ?_
  rw [List.mem_range] at hk
  refine congrArg List.sum (List.map_congr_left fun i hi => ?_)
  rw [List.mem_range] at hi
  rw [h i (by omega)]

/-- `tmul` against a literal coefficient list is `truncL` of the product
with the corresponding `phiCoeffSeries`. -/
private theorem tmul_phiCoeffSeries_eq (c : List ℚ) (P : PowerSeries ℚ) (n : ℕ) :
    GapWalkBridge.tmul c (KernelSeries.truncL n P) n
      = KernelSeries.truncL n (phiCoeffSeries c * P) := by
  rw [KernelSeries.truncL_mul]
  apply tmul_congr_left
  intro i hi
  rw [KernelSeries.truncL_getD n i _ hi]
  show c.getD i 0 = (coeff i) (phiCoeffSeries c)
  rw [phiCoeffSeries, PowerSeries.coeff_mk]

private theorem truncL_one (n : ℕ) (hn : 1 ≤ n) :
    KernelSeries.truncL n (1 : PowerSeries ℚ) = (1 : ℚ) :: List.replicate (n - 1) 0 := by
  apply List.ext_getElem
  · rw [KernelSeries.truncL_length]
    simp; omega
  · intro k h1 h2
    rw [← List.getD_eq_getElem _ 0 h1, ← List.getD_eq_getElem _ 0 h2]
    rw [KernelSeries.truncL_length] at h1
    rw [KernelSeries.truncL_getD n k _ h1]
    rcases k with _ | k
    · simp
    · rw [PowerSeries.coeff_one, if_neg (Nat.succ_ne_zero k)]
      simp [List.getD_cons_succ, List.getD_replicate]

private theorem truncL_zero (n : ℕ) :
    KernelSeries.truncL n (0 : PowerSeries ℚ) = List.replicate n 0 := by
  apply List.ext_getElem
  · simp [KernelSeries.truncL_length]
  · intro k h1 h2
    rw [← List.getD_eq_getElem _ 0 h1]
    rw [KernelSeries.truncL_length] at h1
    rw [KernelSeries.truncL_getD n k _ h1]
    simp

/-- `truncL` turns the pointwise list-sum `phiApply`'s fold uses into `+`. -/
private theorem truncL_add (n : ℕ) (F G : PowerSeries ℚ) :
    (List.range n).map (fun k =>
        (KernelSeries.truncL n F).getD k 0 + (KernelSeries.truncL n G).getD k 0)
      = KernelSeries.truncL n (F + G) := by
  symm
  show (List.range n).map (fun k => coeff k (F + G)) = _
  apply List.map_congr_left
  intro k hk
  rw [List.mem_range] at hk
  rw [map_add, KernelSeries.truncL_getD n k F hk, KernelSeries.truncL_getD n k G hk]

/-- **`DepthOneSeries.phi_annihilates`, re-derived without `native_decide`**
from the exact identity `phi_annihilates_exact`, given the piece-D
walk↔closed-form bridge `hbridge` as an explicit hypothesis (see the section
note above). -/
theorem phi_annihilates_of_exact
    (hbridge : KernelSeries.truncL 61 Nexact = DepthOneSeries.nSeries 60) :
    (DepthOneSeries.phiApply (DepthOneSeries.nSeries 60) 61).all (· == 0) = true := by
  rw [← hbridge]
  have hone : (1 : ℚ) :: List.replicate 60 0 = KernelSeries.truncL 61 (1 : PowerSeries ℚ) :=
    (truncL_one 61 (by norm_num)).symm
  have key : DepthOneSeries.phiApply (KernelSeries.truncL 61 Nexact) 61
      = KernelSeries.truncL 61 (PhiOp Nexact) := by
    unfold DepthOneSeries.phiApply
    simp only [List.zipWith_cons_cons, List.zipWith_nil, List.foldl_cons, List.foldl_nil]
    rw [show (61 : ℕ) - 1 = 60 from rfl, hone,
      tmul_phiCoeffSeries_eq DepthOneSeries.phiCList0 (1 : PowerSeries ℚ) 61,
      show GapWalkBridge.tmul (KernelSeries.truncL 61 Nexact) (KernelSeries.truncL 61 Nexact) 61
          = KernelSeries.truncL 61 (Nexact * Nexact) from
        (KernelSeries.truncL_mul 61 Nexact Nexact).symm,
      tmul_phiCoeffSeries_eq DepthOneSeries.phiCList1 Nexact 61,
      show GapWalkBridge.tmul (KernelSeries.truncL 61 (Nexact * Nexact))
            (KernelSeries.truncL 61 Nexact) 61
          = KernelSeries.truncL 61 (Nexact * Nexact * Nexact) from
        (KernelSeries.truncL_mul 61 (Nexact * Nexact) Nexact).symm,
      tmul_phiCoeffSeries_eq DepthOneSeries.phiCList2 (Nexact * Nexact) 61,
      show GapWalkBridge.tmul (KernelSeries.truncL 61 (Nexact * Nexact * Nexact))
            (KernelSeries.truncL 61 Nexact) 61
          = KernelSeries.truncL 61 (Nexact * Nexact * Nexact * Nexact) from
        (KernelSeries.truncL_mul 61 (Nexact * Nexact * Nexact) Nexact).symm,
      tmul_phiCoeffSeries_eq DepthOneSeries.phiCList3 (Nexact * Nexact * Nexact) 61,
      tmul_phiCoeffSeries_eq DepthOneSeries.phiCList4 (Nexact * Nexact * Nexact * Nexact) 61,
      ← truncL_zero 61, truncL_add, truncL_add, truncL_add, truncL_add, truncL_add]
    congr 1
    unfold PhiOp
    ring
  rw [key, phi_annihilates_exact, truncL_zero]
  simp

