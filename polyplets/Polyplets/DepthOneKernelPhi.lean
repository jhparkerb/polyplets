/-! ### Step (A.4): the `×3` coefficient hom, and `N = 1 + 3·scale3(F1y)` -/

/-- `scale3 F` has coefficient `n` equal to `3ⁿ · coeff n F`: the `x ↦ 3x`
substitution, built coefficient-wise (mirrors `sgnHom`). -/
private noncomputable def scale3 : PowerSeries ℚ →+* PowerSeries ℚ where
  toFun F := PowerSeries.mk fun n => (3 : ℚ) ^ n * coeff n F
  map_one' := by
    ext n
    rw [PowerSeries.coeff_mk]
    rcases n with _ | n
    · simp
    · simp [PowerSeries.coeff_one]
  map_zero' := by ext n; simp [PowerSeries.coeff_mk]
  map_add' := by
    intro F G
    ext n
    simp only [PowerSeries.coeff_mk, map_add]
    ring
  map_mul' := by
    intro F G
    ext n
    simp only [PowerSeries.coeff_mk, PowerSeries.coeff_mul]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun p hp => ?_
    rw [Finset.mem_antidiagonal] at hp
    have hpow : (3 : ℚ) ^ n = (3 : ℚ) ^ p.1 * (3 : ℚ) ^ p.2 := by
      rw [← pow_add, hp]
    rw [hpow]; ring

private theorem coeff_scale3 (F : PowerSeries ℚ) (n : ℕ) :
    coeff n (scale3 F) = (3 : ℚ) ^ n * coeff n F := by
  change coeff n (PowerSeries.mk fun n => (3 : ℚ) ^ n * coeff n F) = _
  rw [PowerSeries.coeff_mk]

private theorem scale3_X : scale3 X = 3 * X := by
  ext n
  rw [coeff_scale3, PowerSeries.coeff_X,
    show (3 : PowerSeries ℚ) = PowerSeries.C 3 from (map_ofNat PowerSeries.C 3).symm,
    show (X : PowerSeries ℚ) = X ^ 1 from (pow_one X).symm, PowerSeries.coeff_C_mul_X_pow]
  rcases eq_or_ne n 1 with h | h
  · subst h; norm_num
  · simp [h]

/-- `N(x) − 1 = 3·scale3(F1y)`: `Nexact`'s own coefficient formula, read off. -/
private theorem Nexact_sub_one : Nexact - 1 = 3 * scale3 F1y := by
  ext n
  rw [map_sub, coeff_one]
  unfold Nexact
  rw [PowerSeries.coeff_mk,
    show (3 : PowerSeries ℚ) = PowerSeries.C 3 from (map_ofNat PowerSeries.C 3).symm,
    PowerSeries.coeff_C_mul, coeff_scale3]
  ring

