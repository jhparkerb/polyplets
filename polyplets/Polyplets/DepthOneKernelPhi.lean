  simp only [phiCY0List, List.length_cons, List.length_nil, Finset.sum_range_succ,
    Finset.sum_range_zero, List.getD_cons_zero, List.getD_cons_succ, zero_add,
    map_add, map_mul, map_pow, PowerSeries.expand_X, PowerSeries.expand_C]
  unfold phiCY0sq
  simp only [map_neg, map_ofNat]
  ring

