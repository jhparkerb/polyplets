noncomputable def phiCY2 : PowerSeries ℚ := 11268 + (-198531) * X + 807414 * X ^ 2 + 723746 * X ^ 3 + (-1131672) * X ^ 4 + 131385 * X ^ 5 + 215382 * X ^ 6 + (-60912) * X ^ 7 + 7776 * X ^ 8
noncomputable def phiCY3 : PowerSeries ℚ := 17892 + (-314037) * X + 1283310 * X ^ 2 + 1043005 * X ^ 3 + (-1830072) * X ^ 4 + 313541 * X ^ 5 + 305046 * X ^ 6 + (-93069) * X ^ 7 + 11664 * X ^ 8
noncomputable def phiCY4 : PowerSeries ℚ := 10584 + (-186471) * X + 771579 * X ^ 2 + 564573 * X ^ 3 + (-1112861) * X ^ 4 + 248715 * X ^ 5 + 160137 * X ^ 6 + (-53217) * X ^ 7 + 6561 * X ^ 8

/-- `y`-form quartic coefficient lists (for `lift_identity`). -/
def phiCY0List : List ℚ := [324, -5886, 24291, 26052, -32141, -240, 7760, -1920, 256]
def phiCY1List : List ℚ := [3132, -55827, 227694, 223812, -311462, 17711, 66988, -17680, 2304]
def phiCY2List : List ℚ := [11268, -198531, 807414, 723746, -1131672, 131385, 215382, -60912, 7776]
def phiCY3List : List ℚ := [17892, -314037, 1283310, 1043005, -1830072, 313541, 305046, -93069, 11664]
def phiCY4List : List ℚ := [10584, -186471, 771579, 564573, -1112861, 248715, 160137, -53217, 6561]

/-- The lift identity, `3·Σ cY_k(3x)((W−1)/3)^k = Σ phiC_k(x) Wᵏ`, as a scalar
`ring` identity in `x, W` over `ℚ` (`phiC` via `DepthOneSeries.evalPoly`).
Verified in `experiments/notary_kdelta_gen6.py`. -/
theorem lift_identity (x W : ℚ) :
    3 * (DepthOneSeries.evalPoly phiCY0List (3 * x)
          + DepthOneSeries.evalPoly phiCY1List (3 * x) * ((W - 1) / 3)
          + DepthOneSeries.evalPoly phiCY2List (3 * x) * ((W - 1) / 3) ^ 2
          + DepthOneSeries.evalPoly phiCY3List (3 * x) * ((W - 1) / 3) ^ 3
          + DepthOneSeries.evalPoly phiCY4List (3 * x) * ((W - 1) / 3) ^ 4)
      = DepthOneSeries.evalPoly DepthOneSeries.phiCList0 x
          + DepthOneSeries.evalPoly DepthOneSeries.phiCList1 x * W
          + DepthOneSeries.evalPoly DepthOneSeries.phiCList2 x * W ^ 2
          + DepthOneSeries.evalPoly DepthOneSeries.phiCList3 x * W ^ 3
          + DepthOneSeries.evalPoly DepthOneSeries.phiCList4 x * W ^ 4 := by
  simp only [DepthOneSeries.evalPoly, phiCY0List, phiCY1List, phiCY2List, phiCY3List, phiCY4List,
    DepthOneSeries.phiCList0, DepthOneSeries.phiCList1, DepthOneSeries.phiCList2,
    DepthOneSeries.phiCList3, DepthOneSeries.phiCList4, List.foldr]
  ring

/-! ## The exact defect series and the head theorem

The remaining sorries are the power-series glue.  All are provable from
`quartic_tuple`, `lift_identity`, the evenness of `phiF1`, and the walk↔
closed-form identities of `DepthOneKernelSol`/`Unique`; none needs
`native_decide`.  See the module docstring for the design. -/

/-- `phiDen` is a unit in `ℚ⟦X⟧`: its constant term is `-42336 ≠ 0`. -/
theorem phiDen_const : constantCoeff phiDen = -42336 := by
  unfold phiDen
  simp [map_add, map_mul, map_pow, map_neg, map_ofNat, PowerSeries.constantCoeff_X]

/-! ### The sign involution `sgn`, `X ↦ −X` coefficient-wise

`PowerSeries.rescale` does not exist in this Mathlib (see the module
docstring), so the `X ↦ −X` involution is built directly as a coefficient
map and shown to be a ring homomorphism from first principles. -/

/-- `sgn F` has coefficient `n` equal to `(−1)ⁿ · coeff n F`: the `X ↦ −X`
substitution, built coefficient-wise. -/
private noncomputable def sgnHom : PowerSeries ℚ →+* PowerSeries ℚ where
  toFun F := PowerSeries.mk fun n => (-1 : ℚ) ^ n * coeff n F
  map_one' := by
    ext n
    rw [PowerSeries.coeff_mk]
    rcases n with _ | n
    · simp
    · simp [PowerSeries.coeff_one]
  map_zero' := by ext n; simp [PowerSeries.coeff_mk]
  map_add' := by
    intro F G
    ext n
    simp only [PowerSeries.coeff_mk, map_add]
    ring
  map_mul' := by
    intro F G
    ext n
    simp only [PowerSeries.coeff_mk, PowerSeries.coeff_mul]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun p hp => ?_
    rw [Finset.mem_antidiagonal] at hp
    have hpow : (-1 : ℚ) ^ n = (-1 : ℚ) ^ p.1 * (-1 : ℚ) ^ p.2 := by
      rw [← pow_add, hp]
    rw [hpow]; ring

private theorem coeff_sgnHom (F : PowerSeries ℚ) (n : ℕ) :
    coeff n (sgnHom F) = (-1 : ℚ) ^ n * coeff n F := by
  change coeff n (PowerSeries.mk fun n => (-1 : ℚ) ^ n * coeff n F) = _
  rw [PowerSeries.coeff_mk]

private theorem sgnHom_X : sgnHom X = -X := by
  ext n
  rw [coeff_sgnHom, PowerSeries.coeff_X, map_neg, PowerSeries.coeff_X]
  rcases eq_or_ne n 1 with h | h
  · subst h; norm_num
  · simp [h]

/-- The `aaC`/`bbC` coefficient functions are exact sign-twists of each other. -/
private theorem bbC_eq_sgn_aaC (n : ℕ) : Kernel.bbC n = (-1 : ℚ) ^ n * Kernel.aaC n := by
  rcases n with _ | _ | _ | n
  · simp [Kernel.aaC, Kernel.bbC]
  · simp [Kernel.aaC, Kernel.bbC]
  · simp [Kernel.aaC, Kernel.bbC]
  · simp [Kernel.aaC, Kernel.bbC]

/-- The recursion equation at the `sqrtCoef` level, re-derived (the private
lemma `Kernel.sqrtCoef_succ` is not exported); the proof mirrors it exactly,
using only the public `sqrtList_length` / `sqrtList_getD_mono`. -/
private theorem sqrtCoef_succ' (t : ℕ → ℚ) (n : ℕ) :
    Kernel.sqrtCoef t (n + 1) = (t (n + 1) -
      ∑ i ∈ Finset.Ioo 0 (n + 1), Kernel.sqrtCoef t i * Kernel.sqrtCoef t (n + 1 - i)) / 2 := by
  have hlen : (Kernel.sqrtList t n).length = n + 1 := Kernel.sqrtList_length t n
  have hstep : Kernel.sqrtCoef t (n + 1) =
      (Kernel.sqrtList t n ++ [(t (n + 1) -
        ∑ i ∈ Finset.Ioo 0 (n + 1),
          (Kernel.sqrtList t n).getD i 0 * (Kernel.sqrtList t n).getD (n + 1 - i) 0) / 2]).getD (n + 1) 0 :=
    rfl
  rw [hstep, List.getD_append_right _ _ _ _ (by omega), hlen]
  have hz : n + 1 - (n + 1) = 0 := by omega
  rw [hz, List.getD_cons_zero]
  have hsum : ∑ i ∈ Finset.Ioo 0 (n + 1),
      (Kernel.sqrtList t n).getD i 0 * (Kernel.sqrtList t n).getD (n + 1 - i) 0 =
      ∑ i ∈ Finset.Ioo 0 (n + 1), Kernel.sqrtCoef t i * Kernel.sqrtCoef t (n + 1 - i) := by
    refine Finset.sum_congr rfl fun i hi => ?_
    simp only [Finset.mem_Ioo] at hi
    show (Kernel.sqrtList t n).getD i 0 * (Kernel.sqrtList t n).getD (n + 1 - i) 0 =
      Kernel.sqrtCoef t i * Kernel.sqrtCoef t (n + 1 - i)
    rw [show (Kernel.sqrtList t n).getD i 0 = Kernel.sqrtCoef t i from
        Kernel.sqrtList_getD_mono t (by omega : i ≤ n) (le_refl i),
      show (Kernel.sqrtList t n).getD (n + 1 - i) 0 = Kernel.sqrtCoef t (n + 1 - i) from
        Kernel.sqrtList_getD_mono t (by omega : n + 1 - i ≤ n) (le_refl (n + 1 - i))]
  rw [hsum]

/-- `√bbC` is the sign-twist of `√aaC`, coefficient by coefficient — the
strengthened `∀ m ≤ n` form, proved by ordinary induction on `n` (the
recursion at `n+1` reaches back to every `i ≤ n`, so the bare statement
is not self-sufficient as an induction hypothesis). -/
private theorem sqrtCoef_bbC_eq_sgn_le (n : ℕ) :
    ∀ m ≤ n, Kernel.sqrtCoef Kernel.bbC m = (-1 : ℚ) ^ m * Kernel.sqrtCoef Kernel.aaC m := by
  induction n with
  | zero =>
    intro m hm
    have : m = 0 := Nat.le_zero.mp hm
    subst this; simp [Kernel.sqrtCoef_zero]
  | succ n ih =>
    intro m hm
    rcases Nat.lt_or_ge m (n + 1) with h | h
    · exact ih m (by omega)
    · have hm' : m = n + 1 := le_antisymm hm h
      subst hm'
      rw [sqrtCoef_succ' Kernel.bbC n, sqrtCoef_succ' Kernel.aaC n, bbC_eq_sgn_aaC (n + 1)]
      have hsum : ∑ i ∈ Finset.Ioo 0 (n + 1),
          Kernel.sqrtCoef Kernel.bbC i * Kernel.sqrtCoef Kernel.bbC (n + 1 - i) =
          (-1 : ℚ) ^ (n + 1) * ∑ i ∈ Finset.Ioo 0 (n + 1),
            Kernel.sqrtCoef Kernel.aaC i * Kernel.sqrtCoef Kernel.aaC (n + 1 - i) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun i hi => ?_
        simp only [Finset.mem_Ioo] at hi
        rw [ih i (by omega), ih (n + 1 - i) (by omega)]
        have hpow : (-1 : ℚ) ^ i * (-1 : ℚ) ^ (n + 1 - i) = (-1 : ℚ) ^ (n + 1) := by
          rw [← pow_add]; congr 1; omega
        rw [show (-1 : ℚ) ^ i * Kernel.sqrtCoef Kernel.aaC i *
              ((-1 : ℚ) ^ (n + 1 - i) * Kernel.sqrtCoef Kernel.aaC (n + 1 - i)) =
            ((-1 : ℚ) ^ i * (-1 : ℚ) ^ (n + 1 - i)) *
              (Kernel.sqrtCoef Kernel.aaC i * Kernel.sqrtCoef Kernel.aaC (n + 1 - i)) from by ring,
          hpow]
      rw [hsum]; ring

/-- `√bbC` is the sign-twist of `√aaC`, coefficient by coefficient. -/
private theorem sqrtCoef_bbC_eq_sgn (n : ℕ) :
    Kernel.sqrtCoef Kernel.bbC n = (-1 : ℚ) ^ n * Kernel.sqrtCoef Kernel.aaC n :=
  sqrtCoef_bbC_eq_sgn_le n n le_rfl

/-- `sgn A = B`: the two square roots are sign-twists of each other. -/
private theorem sgnHom_A : sgnHom Kernel.A = Kernel.B := by
  ext n
  rw [coeff_sgnHom]
  unfold Kernel.A Kernel.B
  rw [PowerSeries.coeff_mk, PowerSeries.coeff_mk]
  exact (sqrtCoef_bbC_eq_sgn n).symm

/-- `sgn B = A`: the reverse sign-twist. -/
private theorem sgnHom_B : sgnHom Kernel.B = Kernel.A := by
  ext n
  rw [coeff_sgnHom]
  unfold Kernel.A Kernel.B
  rw [PowerSeries.coeff_mk, PowerSeries.coeff_mk,
    sqrtCoef_bbC_eq_sgn n, ← mul_assoc, ← mul_pow]
  norm_num

/-! ### `sgn`-invariance of the assembled pieces -/

private theorem sgnHom_phiN0 : sgnHom phiN0 = phiN0 := by
  unfold phiN0
  simp only [map_add, map_mul, map_pow, map_neg, map_ofNat, sgnHom_X]
  ring

private theorem sgnHom_phiN3 : sgnHom phiN3 = phiN3 := by
  unfold phiN3
  simp only [map_add, map_mul, map_pow, map_neg, map_ofNat, sgnHom_X]
  ring

private theorem sgnHom_phiDen : sgnHom phiDen = phiDen := by
  unfold phiDen
  simp only [map_add, map_mul, map_pow, map_neg, map_ofNat, sgnHom_X]
  ring

private theorem sgnHom_phiN1 : sgnHom phiN1 = phiN2 := by
  unfold phiN1 phiN2
  simp only [map_add, map_mul, map_pow, map_neg, map_ofNat, sgnHom_X]
  ring

private theorem sgnHom_phiN2 : sgnHom phiN2 = phiN1 := by
  unfold phiN1 phiN2
  simp only [map_add, map_mul, map_pow, map_neg, map_ofNat, sgnHom_X]
  ring

private theorem sgnHom_dd : sgnHom dd = dd := by
  unfold dd
  simp only [map_add, map_mul, sgnHom_phiN1, sgnHom_phiN2, sgnHom_phiN3, sgnHom_A, sgnHom_B]
  ring

private theorem sgnHom_numTuple : sgnHom numTuple = numTuple := by
  unfold numTuple
  rw [map_add, sgnHom_phiN0, sgnHom_dd]

private theorem sgnHom_phiDen_inv : sgnHom (phiDen)⁻¹ = (phiDen)⁻¹ := by
  have hne : constantCoeff phiDen ≠ 0 := by rw [phiDen_const]; norm_num
  have h1 : phiDen * phiDen⁻¹ = 1 := PowerSeries.mul_inv_cancel _ hne
  have h2 : sgnHom phiDen * sgnHom phiDen⁻¹ = 1 := by rw [← map_mul, h1, map_one]
  rw [sgnHom_phiDen] at h2
  have hphiDen_ne : phiDen ≠ 0 := by
    intro h
    rw [h, map_zero] at hne
    exact hne rfl
  have heq : phiDen * phiDen⁻¹ = phiDen * sgnHom phiDen⁻¹ := h1.trans h2.symm
  exact (mul_left_cancel₀ hphiDen_ne heq).symm

private theorem sgnHom_phiF1 : sgnHom phiF1 = phiF1 := by
  unfold phiF1
  rw [map_mul, sgnHom_numTuple, sgnHom_phiDen_inv]

/-- `phiF1` is even: its odd coefficients vanish. -/
theorem phiF1_even (k : ℕ) : (coeff (2 * k + 1)) phiF1 = 0 := by
  have h := congrArg (coeff (2 * k + 1)) sgnHom_phiF1
  rw [coeff_sgnHom] at h
  have hpow : (-1 : ℚ) ^ (2 * k + 1) = -1 := by
    rw [pow_succ, pow_mul]; norm_num
  rw [hpow, neg_one_mul] at h
  linarith

/-- The `y`-series behind `F₁`: `F1y k = coeff (2k) phiF1`. -/
noncomputable def F1y : PowerSeries ℚ := PowerSeries.mk fun k => (coeff (2 * k)) phiF1

/-- The exact walk series `N(x) = 3·F₁(3x) + 1`, coefficient-wise. -/
noncomputable def Nexact : PowerSeries ℚ :=
  PowerSeries.mk fun k => 3 ^ (k + 1) * (coeff k) F1y + (if k = 0 then 1 else 0)

/-- `Φ` as a power-series operator, banked `x`-coefficient lists as series. -/
noncomputable def phiCoeffSeries (c : List ℚ) : PowerSeries ℚ :=
  PowerSeries.mk fun n => c.getD n 0

noncomputable def PhiOp (Wser : PowerSeries ℚ) : PowerSeries ℚ :=
  phiCoeffSeries DepthOneSeries.phiCList0
    + phiCoeffSeries DepthOneSeries.phiCList1 * Wser
    + phiCoeffSeries DepthOneSeries.phiCList2 * Wser ^ 2
    + phiCoeffSeries DepthOneSeries.phiCList3 * Wser ^ 3
    + phiCoeffSeries DepthOneSeries.phiCList4 * Wser ^ 4

/-! ## The cleared quartic: `Σ_k cY_k(X²)·numTuple^k·phiDen^(4−k) = 0`

The banked `cY_k` are the raw elimination coefficients divided by a degree-40
factor `g(X)` (constant term `303521499316224 ≠ 0`).  We never need `g` in
Lean: `g·bracket = phiDen⁴·Ψ(numTuple) ≡ 0` mod the square relations, and
`ℚ[X]` is a domain, so the nonzero scalar `g` is a non-zero-divisor on the
rank-4 module `ℚ[X,a,b]/(a²−AA, b²−BB)` — hence `bracket ≡ 0` on its own, with
its own `A_sq`/`B_sq` certificate (`experiments/notary_kdelta_gen7.py`). -/

noncomputable def phiCY0sq : PowerSeries ℚ :=
  324 + (-5886) * X ^ 2 + 24291 * X ^ 4 + 26052 * X ^ 6 + (-32141) * X ^ 8 + (-240) * X ^ 10 + 7760 * X ^ 12 + (-1920) * X ^ 14 + 256 * X ^ 16
noncomputable def phiCY1sq : PowerSeries ℚ :=
  3132 + (-55827) * X ^ 2 + 227694 * X ^ 4 + 223812 * X ^ 6 + (-311462) * X ^ 8 + 17711 * X ^ 10 + 66988 * X ^ 12 + (-17680) * X ^ 14 + 2304 * X ^ 16
noncomputable def phiCY2sq : PowerSeries ℚ :=
  11268 + (-198531) * X ^ 2 + 807414 * X ^ 4 + 723746 * X ^ 6 + (-1131672) * X ^ 8 + 131385 * X ^ 10 + 215382 * X ^ 12 + (-60912) * X ^ 14 + 7776 * X ^ 16
noncomputable def phiCY3sq : PowerSeries ℚ :=
  17892 + (-314037) * X ^ 2 + 1283310 * X ^ 4 + 1043005 * X ^ 6 + (-1830072) * X ^ 8 + 313541 * X ^ 10 + 305046 * X ^ 12 + (-93069) * X ^ 14 + 11664 * X ^ 16
noncomputable def phiCY4sq : PowerSeries ℚ :=
  10584 + (-186471) * X ^ 2 + 771579 * X ^ 4 + 564573 * X ^ 6 + (-1112861) * X ^ 8 + 248715 * X ^ 10 + 160137 * X ^ 12 + (-53217) * X ^ 14 + 6561 * X ^ 16

noncomputable def bracket : PowerSeries ℚ :=
  phiCY0sq * phiDen ^ 4 + phiCY1sq * numTuple * phiDen ^ 3 +
    phiCY2sq * numTuple ^ 2 * phiDen ^ 2 + phiCY3sq * numTuple ^ 3 * phiDen +
    phiCY4sq * numTuple ^ 4

