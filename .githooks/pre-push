#!/usr/bin/env bash
# Pre-push gate: run the fast regression subset before anything leaves the
# machine. Targets the classes this repo has actually shipped — closed-form
# brute-force, silent-wrong guards, combine/runfile integrity (see
# AUDIT-2026-06-28.md). Install once with `make install-hooks`.
#
# Additionally run the FULL default `gates` chain (~3 min) when the push
# touches anything beyond documentation. The fast subset is a curated
# allowlist, and curated subsets have blind spots: the sym/symcount.py
# deletion (754871a) broke bare `make` for 27 days while every push passed
# ns-gate-fast. Fail closed: new refs and unrecognized paths get the full
# chain.
#
# Genuine emergency bypass: `git push --no-verify` — then fix what you skipped.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000

docs_only=1
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue          # ref deletion: nothing to test
  if [ "$rsha" = "$zero" ]; then
    docs_only=0                              # new ref: no base to diff, fail closed
    continue
  fi
  while read -r f; do
    case "$f" in
      # Prose and assets only. .txt and .log are NOT here: gates read
      # results/holes_n14.txt, results/siteperim_*.txt and fixtures/b*.txt as
      # DATA, so treating any .txt as prose let an edit to a gate's own fixture
      # skip the gate that checks it -- the same fail-open shape as the
      # ns-gate-fast allowlist this hook's header warns about.
      *.md|*.tex|*.bib|*.pdf|*.png|*.svg) ;;
      *) docs_only=0 ;;                                    # anything else = code
    esac
  done < <(git -C "$root" diff --name-only "$rsha" "$lsha")
done

# Say what the push spent. A hook that costs a minute and does not report how
# it was spent cannot be profiled from the outside.
t0=$SECONDS
echo "pre-push: make ns-gate-fast"
make -C "$root" ns-gate-fast
t_fast=$((SECONDS - t0))

t_gates=0
if [ "$docs_only" -eq 0 ]; then
  echo "pre-push: push touches code — full 'make gates' (emergency bypass: git push --no-verify)"
  t1=$SECONDS
  make -C "$root" gates
  t_gates=$((SECONDS - t1))
fi
echo "pre-push: ns-gate-fast ${t_fast}s, gates ${t_gates}s, total $((SECONDS - t0))s"
